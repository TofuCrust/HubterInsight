# Salin menjadi .env lalu isi. File .env tidak boleh masuk git.

# Domain (atau subdomain) yang sudah diarahkan ke IP VPS lewat record A
DOMAIN=chat.contoh.id

# Email untuk Let's Encrypt (pemberitahuan sertifikat akan kedaluwarsa)
LETSENCRYPT_EMAIL=nama@contoh.id

# Mode jawaban: "mock" = hanya menampilkan bagian dokumen relevan (gratis), "openai" = jawaban disusun OpenAI (RAG)
LLM_MODE=mock

# Wajib diisi bila LLM_MODE=openai. Jangan dibagikan atau dimasukkan ke git.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low   # minimal | low | medium | high

# Login bersama untuk pemakai internal (halaman masuk). Kosongkan AUTH_PASSWORD = tanpa login.
# AUTH_USER=hubter
AUTH_PASSWORD=
# Kunci tanda tangan cookie sesi (acak, panjang). Kosong = diturunkan dari kata sandi.
AUTH_SECRET=

# Opsional: batas pemakaian (per IP, kecuali total). Nilai bawaan untuk pemakaian internal beberapa orang.
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_PER_DAY=300
# DAILY_REQUEST_CAP=600        # total semua pemakai per hari; pelindung kredit
# LOGIN_RATE_PER_MINUTE=30
# LOGIN_RATE_PER_DAY=500

# Opsional: ubah port host (default 80/443). Berguna untuk uji lokal.
# HTTP_PORT=80
# HTTPS_PORT=443
